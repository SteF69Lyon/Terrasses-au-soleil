---
export interface Props {
  slotId: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'vertical';
}
const { slotId, format = 'auto' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';

// A slot ID made of the same digit repeated (e.g. "1111111111") is a
// placeholder that hasn't been wired to a real AdSense ad unit yet. We
// render nothing at all in that case — no visible "(auto)" placeholder
// either — so that AdSense reviewers don't see empty boxes that suggest
// broken or unfilled ad inventory.
const isPlaceholderSlot = /^(\d)\1{4,}$/.test(slotId);

const enabled = Boolean(client) && !isPlaceholderSlot;
---
{enabled && (
  <div class="ad-slot">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={client}
         data-ad-slot={slotId}
         data-ad-format={format}
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
